<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rewardly - Login & Wallet</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background: #f4f6f9; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
    .card { background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 400px; text-align: center; margin: 10px; }
    h2 { margin-bottom: 0.5rem; color: #333; }
    p { color: #666; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .btn { width: 100%; padding: 12px; border: none; border-radius: 6px; font-size: 1rem; cursor: pointer; margin-bottom: 10px; font-weight: bold; transition: 0.2s; }
    .btn-google { background: #4285F4; color: white; }
    .btn-phone { background: #25D366; color: white; }
    .btn-submit { background: #333; color: white; }
    input { width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 6px; }
    #phone-section { display: none; margin-top: 15px; text-align: left; }
    #recaptcha-container { display: flex; justify-content: center; margin-bottom: 10px; }
  </style>

  <!-- Corrected Firebase Web SDKs -->
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>

  <!-- Razorpay Checkout SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body>

<div class="card">
  <h2>Welcome to Rewardly 👋</h2>
  <p>Choose your preferred login method</p>

  <!-- Google Sign-In Button -->
  <button class="btn btn-google" onclick="loginWithGoogle()">Continue with Google</button>
  
  <!-- Phone Login Button -->
  <button class="btn btn-phone" onclick="showPhoneSection()">Continue with Phone OTP</button>

  <!-- Phone OTP UI Section -->
  <div id="phone-section">
    <input type="tel" id="phoneNumber" placeholder="+919876543210">
    <div id="recaptcha-container"></div>
    <button class="btn btn-submit" id="send-otp-btn" onclick="sendOTP()">Send OTP</button>

    <div id="otp-confirm-group" style="display: none; margin-top: 10px;">
      <input type="text" id="otpCode" placeholder="Enter 6-digit OTP">
      <button class="btn btn-submit" onclick="verifyOTP()">Verify OTP</button>
    </div>
  </div>

  <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;">

  <h3>Add Points to Wallet 💳</h3>
  <button class="btn btn-submit" onclick="addMoney(10)">+ Add ₹10 (1000 Points)</button>
  <button class="btn btn-submit" onclick="addMoney(50)">+ Add ₹50 (5000 Points)</button>
</div>

<script>
  // Your Firebase Configuration
  const firebaseConfig = {
    apiKey: "AIzaSyBaLYru0CZjVXxc4sU0KEiHw0mcz-8LiQY",
    authDomain: "rewardly-5e54a.firebaseapp.com",
    projectId: "rewardly-5e54a",
    storageBucket: "rewardly-5e54a.firebasestorage.app",
    messagingSenderId: "648357307052",
    appId: "1:648357307052:web:9732089e2bb0b4bbb4f509",
    measurementId: "G-ET7FJLYGGT"
  };

  firebase.initializeApp(firebaseConfig);

  // Google Login
  function loginWithGoogle() {
    const provider = new firebase.auth.GoogleAuthProvider();
    firebase.auth().signInWithPopup(provider)
      .then((result) => sendTokenToBackend(result.user))
      .catch((error) => alert(error.message));
  }

  // Show Phone UI
  function showPhoneSection() {
    document.getElementById('phone-section').style.display = 'block';
    if (!window.recaptchaVerifier) {
      window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', { 'size': 'invisible' });
    }
  }

  // Send OTP
  function sendOTP() {
    const phoneNumber = document.getElementById('phoneNumber').value;
    if (!phoneNumber) return alert("Please enter phone number with country code!");

    firebase.auth().signInWithPhoneNumber(phoneNumber, window.recaptchaVerifier)
      .then((confirmationResult) => {
        window.confirmationResult = confirmationResult;
        document.getElementById('otp-confirm-group').style.display = 'block';
        document.getElementById('send-otp-btn').style.display = 'none';
        alert("OTP Sent Successfully!");
      }).catch((error) => alert(error.message));
  }

  // Verify OTP
  function verifyOTP() {
    const code = document.getElementById('otpCode').value;
    window.confirmationResult.confirm(code)
      .then((result) => sendTokenToBackend(result.user))
      .catch((error) => alert("Invalid OTP!"));
  }

  // Send Firebase Token to Backend API
  async function sendTokenToBackend(user) {
    const idToken = await user.getIdToken();
    const res = await fetch('/api/auth/firebase', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken })
    });
    const data = await res.json();
    if (data.ok) {
      alert("Login Successful! Welcome " + (user.displayName || user.phoneNumber || user.email));
      window.location.reload();
    } else {
      alert("Backend Auth Failed: " + data.error);
    }
  }

  // Razorpay Add Money Function
  async function addMoney(amountInINR) {
    const token = localStorage.getItem('token');
    
    const res = await fetch('/api/payment/create-order', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token 
      },
      body: JSON.stringify({ amount: amountInINR })
    });
    const data = await res.json();

    if (!data.order) {
      alert("Error creating payment order!");
      return;
    }

    const options = {
      "key": data.key_id,
      "amount": data.order.amount,
      "currency": "INR",
      "name": "Rewardly Wallet",
      "description": "Add Points to Wallet",
      "order_id": data.order.id,
      "handler": async function (response) {
        const verifyRes = await fetch('/api/payment/verify', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token 
          },
          body: JSON.stringify({
            razorpay_order_id: response.razorpay_order_id,
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_signature: response.razorpay_signature,
            amount: amountInINR
          })
        });
        const verifyData = await verifyRes.json();
        if(verifyData.status === 'success') {
          alert('Payment Successful! Points added to wallet.');
          window.location.reload();
        } else {
          alert('Payment verification failed.');
        }
      }
    };
    const rzp1 = new Razorpay(options);
    rzp1.open();
  }
</script>
</body>
</html>
